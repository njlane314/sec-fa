#!/usr/bin/env sh
set -eu
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$#" -gt 0 ]; then
    cmd=$1
    shift
    case "$cmd" in
        init) set -- init-db "$@" ;;
        sym) set -- security-upsert "$@" ;;
        pos) set -- position-upsert "$@" ;;
        watch) set -- sec-watch "$@" ;;
        pull) set -- sec-fetch "$@" ;;
        comp) set -- facts-companyfacts "$@" ;;
        xbrl) set -- xbrl-parse "$@" ;;
        univ) set -- universe-build "$@" ;;
        recon) set -- broker-reconcile "$@" ;;
        plan) set -- model-run "$@" ;;
        value) set -- model-run-v2 "$@" ;;
        gate) set -- risk-check "$@" ;;
        stage) set -- order-stage "$@" ;;
        send) set -- broker-submit "$@" ;;
        ping) set -- notify "$@" ;;
        stat) set -- status "$@" ;;
        mode) set -- set-mode "$@" ;;
        halt) set -- trading-halt "$@" ;;
        *) set -- "$cmd" "$@" ;;
    esac
fi
PYTHONPATH="$DIR/..${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m sec.cli "$@"
