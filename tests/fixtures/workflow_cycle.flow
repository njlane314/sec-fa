workflow cycle_fixture
driver test.v1
mode observe
decision_as_of 2026-05-08T13:00:00.000Z
allow_external_write false
allow_broker_resource false

layer job key workflow_name

node a
  alg noop.test.v1
  cell job workflow_name=cycle_fixture node=a
  set message a
  input output from b.output
  output output command_output.v1
end

node b
  alg noop.test.v1
  cell job workflow_name=cycle_fixture node=b
  set message b
  input output from a.output
  output output command_output.v1
end
