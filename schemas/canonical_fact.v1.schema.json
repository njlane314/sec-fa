{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_fact.v1",
  "type": "object",
  "required": ["security_id", "metric_id", "value", "period_end_date", "available_at"],
  "properties": {
    "security_id": {"type": "integer"},
    "metric_id": {"type": "integer"},
    "value": {"type": "number"},
    "period_start_date": {"type": ["string", "null"]},
    "period_end_date": {"type": "string"},
    "available_at": {"type": "string"},
    "accession_number": {"type": ["string", "null"]},
    "taxonomy": {"type": ["string", "null"]},
    "tag": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "quality_flags": {"type": "integer"}
  }
}
