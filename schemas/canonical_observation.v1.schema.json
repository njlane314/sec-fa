{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_observation.v1",
  "type": "object",
  "required": [
    "resolver_version",
    "security_id",
    "metric_id",
    "metric_name",
    "metric_kind",
    "basis_id",
    "period_id",
    "period_semantics",
    "duration_days",
    "value_decimal",
    "unit_signature",
    "dimensions_hash",
    "dimensional_scope",
    "observation_status",
    "available_at"
  ],
  "properties": {
    "resolver_version": {"type": "string"},
    "security_id": {"type": "integer"},
    "cik": {"type": "string"},
    "metric_id": {"type": "integer"},
    "metric_name": {"type": "string"},
    "metric_kind": {"enum": ["flow", "instant", "per_share_flow", "ratio", "derived", "unknown"]},
    "basis_id": {"type": "integer"},
    "period_id": {"type": "string"},
    "period_semantics": {"enum": ["fiscal_quarter", "fiscal_ytd", "fiscal_year", "trailing_twelve_month", "instant", "stub", "transition", "irregular", "unknown"]},
    "duration_days": {"type": "integer", "minimum": 0},
    "fiscal_year": {"type": ["integer", "null"]},
    "fiscal_period": {"type": ["string", "null"]},
    "value_decimal": {"type": "number"},
    "unit_signature": {"type": "string"},
    "dimensions_hash": {"type": "string"},
    "dimensional_scope": {"type": "string"},
    "observation_status": {"enum": ["selected", "derived", "rejected", "superseded"]},
    "source_fact_id": {"type": ["string", "null"]},
    "source_accession": {"type": ["string", "null"]},
    "quality_flags": {"type": "integer", "minimum": 0},
    "quality_flags_json": {"type": "array", "items": {"type": "string"}},
    "available_at": {"type": "string"}
  }
}
