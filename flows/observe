#!/usr/bin/env sh
set -eu

# Observe-mode template. It initializes local state, ingests SEC data, runs the
# model and risk gate, then reports. It does not stage or send orders.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SEC="$ROOT/sec"

: "${DB:=$ROOT/.sec.db}"
: "${RAW:=$ROOT/raw}"
: "${CIK:=0000320193}"
: "${SYMBOL:=AAPL}"
: "${PRICE_USD:=200}"
: "${ADV_USD:=5000000000}"
: "${PORTFOLIO_VALUE_USD:=100000}"
: "${CASH_USD:=100000}"
: "${UA:=Your Name your.email@example.com}"

LIB=${LIB:-$ROOT/build/libfolio.so}
[ -f "$LIB" ] || LIB="$ROOT/build/libfolio.dylib"

"$SEC" init --db "$DB"

"$SEC" sym \
  --db "$DB" \
  --cik "$CIK" \
  --symbol "$SYMBOL" \
  --price-usd "$PRICE_USD" \
  --adv-usd "$ADV_USD" \
  --investable 1

"$SEC" pos \
  --db "$DB" \
  --cik "$CIK" \
  --quantity-shares 0 \
  --market-value-usd 0 \
  --weight-ratio 0

"$SEC" watch \
  --db "$DB" \
  --cik "$CIK" \
  --user-agent "$UA"

"$SEC" pull \
  --db "$DB" \
  --raw-root "$RAW" \
  --user-agent "$UA"

if [ -n "${ACCESSION:-}" ]; then
  "$SEC" xbrl \
    --db "$DB" \
    --accession "$ACCESSION" \
    --cik "$CIK" \
    --symbol "$SYMBOL" \
    --raw-root "$RAW" \
    --user-agent "$UA"
else
  printf '%s\n' 'ACCESSION is not set; skipping xbrl parse step.' >&2
fi

"$SEC" univ --db "$DB" --name us_core --min-adv-usd 0 --min-fact-count 2
"$SEC" recon --db "$DB" --portfolio-value-usd "$PORTFOLIO_VALUE_USD" --cash-usd "$CASH_USD" --reconciled 1
"$SEC" plan --db "$DB" --core-lib "$LIB" --portfolio-value-usd "$PORTFOLIO_VALUE_USD" --cash-usd "$CASH_USD"
"$SEC" value --db "$DB" --core-lib "$LIB" --portfolio-value-usd "$PORTFOLIO_VALUE_USD" --cash-usd "$CASH_USD"
"$SEC" gate --db "$DB" --core-lib "$LIB"
"$SEC" report daily --db "$DB"
"$SEC" stat --db "$DB"
