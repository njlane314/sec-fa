{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-fa.local/contracts/workflow.schema.json",
  "title": "Product graph workflow",
  "type": "object",
  "required": ["spec_version", "workflow_name", "driver", "layers", "resources", "nodes"],
  "properties": {
    "spec_version": {"const": 1},
    "workflow_name": {"type": "string", "minLength": 1},
    "driver": {
      "type": "object",
      "required": ["driver_id", "mode", "decision_as_of", "allow_external_write", "allow_broker_resource"],
      "properties": {
        "driver_id": {"type": "string"},
        "mode": {"enum": ["halted", "observe", "shadow", "stage", "paper", "live_limited", "live"]},
        "decision_as_of": {"type": "string"},
        "allow_external_write": {"type": "boolean"},
        "allow_broker_resource": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "parent", "key_fields"],
        "properties": {
          "layer": {"type": "string"},
          "parent": {"type": ["string", "null"]},
          "key_fields": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_id", "resource_kind", "max_concurrent", "min_interval_ms", "allowed_modes", "hazard_class"],
        "properties": {
          "resource_id": {"type": "string"},
          "resource_kind": {"type": "string"},
          "max_concurrent": {"type": "integer"},
          "min_interval_ms": {"type": "integer"},
          "allowed_modes": {"type": "array", "items": {"type": "string"}},
          "hazard_class": {"enum": ["A", "B", "C"]}
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node_id", "algorithm", "cell", "config", "inputs", "outputs"],
        "properties": {
          "node_id": {"type": "string"},
          "algorithm": {"type": "string"},
          "cell": {
            "type": "object",
            "required": ["layer", "key"],
            "properties": {
              "layer": {"type": "string"},
              "key": {"type": "object"}
            },
            "additionalProperties": false
          },
          "config": {"type": "object"},
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "role"],
              "properties": {
                "from": {"type": "string"},
                "role": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "product_type"],
              "properties": {
                "role": {"type": "string"},
                "product_type": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
