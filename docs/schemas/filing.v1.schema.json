{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filing.v1",
  "type": "object",
  "required": ["event_type", "event_version", "event_id", "occurred_at", "payload"],
  "properties": {
    "event_type": {"const": "filing_seen"},
    "event_version": {"const": 1},
    "event_id": {"type": "string"},
    "occurred_at": {"type": "string"},
    "payload": {
      "type": "object",
      "required": ["cik", "accession_number", "form", "filing_date"],
      "properties": {
        "cik": {"type": "string"},
        "accession_number": {"type": "string"},
        "form": {"type": "string"},
        "filing_date": {"type": "string"},
        "accepted_at": {"type": ["string", "null"]},
        "primary_document": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]}
      }
    }
  }
}
