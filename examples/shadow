#!/usr/bin/env sh
set -eu

# Shadow template. It assumes data ingestion has already populated the database.
# It produces model output, risk decisions, staged orders, and reports, but does
# not call send.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
BIN="$ROOT/bin"

: "${DB:=$ROOT/.sec.db}"
: "${PORTFOLIO_VALUE_USD:=100000}"
: "${CASH_USD:=100000}"

LIB=${LIB:-$ROOT/build/libfolio.so}
[ -f "$LIB" ] || LIB="$ROOT/build/libfolio.dylib"

"$BIN/recon" \
  --db "$DB" \
  --portfolio-value-usd "$PORTFOLIO_VALUE_USD" \
  --cash-usd "$CASH_USD" \
  --reconciled 1

"$BIN/plan" \
  --db "$DB" \
  --core-lib "$LIB" \
  --portfolio-value-usd "$PORTFOLIO_VALUE_USD" \
  --cash-usd "$CASH_USD"

"$BIN/gate" --db "$DB" --core-lib "$LIB"
"$BIN/stage" --db "$DB"
"$BIN/report" daily --db "$DB"
